# ============================================================
# Organic-OG: Free & Open Source Environment Configuration
# ============================================================

# 1. Application Runtime
PORT=5173
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development

# 2. Cryptographic URL Signing (Required for HMAC-SHA256 image URL signing)
# Generate via: openssl rand -base64 32
OG_SIGNING_SECRET=your-secure-random-og-signing-secret-at-least-32-chars

# 3. Database Storage
# By default, uses local SQLite file 'local.db' (zero setup required)
# Or provide a Turso / LibSQL connection URL:
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# 4. Distributed Edge Cache (Optional)
# If empty, Organic-OG automatically uses the built-in in-memory LRU cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
