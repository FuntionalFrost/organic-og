# ==========================================
# OG Engine Environment Variables Example
# ==========================================

# --- Database Configuration (Turso / LibSQL SQLite) ---
DATABASE_URL="libsql://your-database-slug.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# --- Public Base URL & Hostname ---
ORIGIN="http://localhost:5173"
PUBLIC_BASE_URL="http://localhost:5173"

# --- OG Image HMAC Security (32+ chars random hex) ---
OG_SIGNING_SECRET="your-32-byte-hex-hmac-signing-secret"

# --- Better-Auth Authentication ---
BETTER_AUTH_SECRET="your-32-byte-hex-auth-secret"
BETTER_AUTH_URL="http://localhost:5173"

# --- GitHub OAuth Integration ---
# Register your OAuth app on GitHub Developer Settings:
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# --- Polar.sh Monetization & Checkout ---
POLAR_ACCESS_TOKEN="polar_oat_your_access_token"
POLAR_WEBHOOK_SECRET="whsec_your_webhook_secret"
POLAR_PRODUCT_STARTER="starter-product-uuid"
POLAR_PRODUCT_GROWTH="growth-product-uuid"
POLAR_PRODUCT_SCALE="scale-product-uuid"
